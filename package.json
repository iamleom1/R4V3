{
  "name": "r4v3",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:mobile": "pnpm --filter @r4v3/mobile start",
    "ios": "pnpm --filter @r4v3/mobile ios",
    "android": "pnpm --filter @r4v3/mobile android",
    "typecheck": "pnpm --filter @r4v3/mobile typecheck",
    "test:mobile": "pnpm --filter @r4v3/mobile test",
    "test:edm": "node --test scripts/test/*.test.mjs",
    "ingest:edm": "node scripts/ingest-edm-events.mjs",
    "healthcheck:edm": "node scripts/healthcheck-edm-ingest.mjs",
    "run:edm:ingest": "node scripts/run-edm-job.mjs ingest",
    "run:edm:healthcheck": "node scripts/run-edm-job.mjs healthcheck"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1"
  },
  "devDependencies": {
    "eas-cli": "^18.4.0"
  }
}
